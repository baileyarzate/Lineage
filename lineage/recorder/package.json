{
  "name": "lineage-recorder",
  "displayName": "Lineage Recorder",
  "description": "Records how assignment code is written so students can prove authorship.",
  "version": "0.1.0",
  "publisher": "lineage",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.lineage.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Lineage only records edits; it never runs code from the project, so it keeps recording in Restricted Mode."
    },
    "virtualWorkspaces": false
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lineage.join",
        "title": "Join Assignment",
        "category": "Lineage"
      },
      {
        "command": "lineage.submit",
        "title": "Submit Assignment",
        "category": "Lineage"
      },
      {
        "command": "lineage.status",
        "title": "Show Recording Status",
        "category": "Lineage"
      },
      {
        "command": "lineage.citeSelection",
        "title": "Cite Selection\u2026",
        "category": "Lineage"
      }
    ],
    "keybindings": [
      {
        "command": "lineage.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "lineage.paste",
        "key": "shift+insert",
        "when": "editorTextFocus && !editorReadonly && !isMac"
      },
      {
        "command": "lineage.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus"
      },
      {
        "command": "lineage.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lineage.citeSelection",
          "when": "lineage.recording && editorHasSelection",
          "group": "9_cutcopypaste@9"
        }
      ],
      "commandPalette": [
        {
          "command": "lineage.citeSelection",
          "when": "lineage.recording"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.95.0",
    "typescript": "~5.6.3"
  }
}
